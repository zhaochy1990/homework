.head {
  align-items: baseline;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.subject {
  font-size: 30rpx;
  font-weight: 600;
}

.badge {
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  color: var(--color-primary);
  background: #e8f8ef;
  border: 1px solid #beebd3;
  font-size: 22rpx;
}

.foot {
  margin-top: 16rpx;
}

.foot .btn {
  width: auto;
  padding: 14rpx 44rpx;
  font-size: 27rpx;
}
