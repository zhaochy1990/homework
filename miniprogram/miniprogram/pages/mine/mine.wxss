.retry {
  display: inline-block;
  width: auto;
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #5b8def;
  color: #ffffff;
  font-size: 34rpx;
}

.avatar.sm {
  width: 60rpx;
  height: 60rpx;
  font-size: 26rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.h3 {
  font-size: 30rpx;
  font-weight: 600;
}

.head {
  padding-bottom: 8rpx;
}

.rowli {
  padding: 18rpx 0;
  border-bottom: var(--hairline) solid var(--color-line);
}

.rowli:last-child {
  border-bottom: none;
}

.left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.li-title {
  font-size: 28rpx;
}

.chip {
  padding: 4rpx 18rpx;
  border: var(--hairline) solid var(--color-line);
  background: var(--color-fill);
  color: var(--color-ink-2);
  font-size: 24rpx;
}

.chip.on {
  border-color: #beebd3;
  background: #e8f8ef;
  color: var(--color-primary);
}

.link {
  color: var(--color-primary);
  font-size: 28rpx;
}

.pad {
  padding: 20rpx 0 8rpx;
}
