.h3 {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.input {
  flex: 1;
  padding: 18rpx 0;
  font-size: 30rpx;
}

.searchline {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: var(--hairline) solid var(--color-line);
}

.search {
  width: auto;
  padding: 12rpx 32rpx;
  font-size: 27rpx;
}

.action {
  margin-top: 24rpx;
}

.hint {
  margin-top: 14rpx;
}

.btn.danger {
  color: var(--color-danger);
}

.retry {
  display: inline-block;
  width: auto;
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
}
