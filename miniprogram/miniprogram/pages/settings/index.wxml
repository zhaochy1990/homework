<view class="page">
  <view class="card">
    <view class="rowline rowli">
      <text class="li-title">昵称</text>
      <text class="sub">{{me ? (me.nickname || '微信用户') : '—'}}</text>
    </view>
    <view class="rowline rowli">
      <text class="li-title">用户 ID</text>
      <text class="sub">{{me ? me.id : '—'}}</text>
    </view>
  </view>

  <view class="card">
    <button class="btn ghost danger" bindtap="logout">退出登录</button>
  </view>
</view>
