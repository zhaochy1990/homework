# 复制到仓库根目录 .env，边做边填。完整说明见 docs/launch-checklist.md。

# ---- 后端服务 ----
ENV=dev
HTTP_ADDR=:8080
INVITE_TOKEN_SECRET=   # 监护人邀请 token 的 HMAC 密钥，随机长串

# ---- MySQL（本地 docker compose up -d mysql）----
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=homework
DB_PASSWORD=homework
DB_NAME=homework
DB_ROOT_PASSWORD=root

# ---- 腾讯云 COS ----
COS_BUCKET=
COS_REGION=
COS_APPID=
COS_DOMAIN=
COS_STS_TTL=45m        # 直传临时密钥/上传会话有效期
COS_PLAYBACK_TTL=2h    # 预签名播放 URL 有效期
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ---- 微信小程序 ----
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_QR_ENV_VERSION=release
API_DOMAIN=
WX_MSGPUSH_TOKEN=
WX_MSGPUSH_AESKEY=

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- STRIDE auth-service ----
AUTH_SERVICE_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=
AUTH_JWT_PUBLIC_KEY_URL=
AUTH_JWT_PUBLIC_KEY_FILE=
